<%= render "layouts/shared/htmldoc" do %>
  <div class="min-h-screen bg-slate-50 text-slate-950 dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto grid min-h-screen max-w-[1440px] grid-cols-1 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_18rem]">
      <aside class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-950/95 lg:h-screen lg:border-b-0 lg:border-r">
        <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 lg:block lg:max-w-none lg:px-3 lg:py-8">
          <%= link_to users_app_root_path, class: "shrink-0 font-display text-3xl font-extrabold tracking-tight", aria: { label: "Insta home" } do %>
            insta<span class="text-rose-600 dark:text-rose-400">.</span>
          <% end %>

          <nav aria-label="Primary" class="flex min-w-0 gap-1 overflow-x-auto lg:mt-10 lg:flex-col lg:overflow-visible">
            <% [
              ["Home", users_app_root_path, :home],
              [t("views.layouts.users.application.explore"), users_explore_path, :explore],
              [t("views.layouts.users.application.notifications"), users_notifications_path, :notifications],
              [t("views.layouts.users.application.bookmarks"), users_bookmarks_path, :bookmarks],
              [t("views.layouts.users.application.profile"), users_account_path, :profile],
              ["Settings", users_settings_path, :settings]
            ].each do |label, path, icon| %>
              <%= link_to path, class: "flex shrink-0 items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition hover:bg-slate-100 aria-[current=page]:bg-rose-50 aria-[current=page]:text-rose-800 dark:hover:bg-slate-900 dark:aria-[current=page]:bg-rose-950 dark:aria-[current=page]:text-rose-200", aria: { current: ("page" if current_page?(path)) } do %>
                <span class="grid size-8 place-items-center rounded-lg bg-slate-100 dark:bg-slate-800" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5">
                    <% case icon %>
                    <% when :home %>
                      <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/>
                    <% when :explore %>
                      <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
                    <% when :notifications %>
                      <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/>
                    <% when :bookmarks %>
                      <path d="M6 4h12v17l-6-4-6 4z"/>
                    <% when :profile %>
                      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
                    <% when :settings %>
                      <circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.7a8 8 0 0 1-1.8 1l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.8-1l-1.7.7-1.4-2.4 1.4-1.1a7 7 0 0 1 0-2l-1.4-1.1 1.4-2.4 1.7.7a8 8 0 0 1 1.8-1l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.8 1l1.7-.7 1.4 2.4-1.4 1.1a7 7 0 0 1 0 2z"/>
                    <% end %>
                  </svg>
                </span>
                <span><%= label %></span>
              <% end %>
            <% end %>
          </nav>

          <div class="hidden border-t border-slate-200 pt-5 dark:border-slate-800 lg:mt-8 lg:block">
            <p class="truncate px-3 text-sm font-semibold">@<%= current_account.username %></p>
            <%= link_to t("views.layouts.users.application.logout"), destroy_user_session_path, data: { turbo_method: :delete }, class: "mt-3 block rounded-xl px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-rose-700 dark:text-slate-400 dark:hover:bg-slate-900 dark:hover:text-rose-300" %>
          </div>
        </div>
      </aside>

      <main class="min-w-0">
        <%= content_for(:with_layout) ? yield(:with_layout) : yield %>
      </main>

      <aside class="hidden px-6 py-10 xl:block">
        <div class="sticky top-8 space-y-5">
          <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <p class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Your space</p>
            <p class="mt-2 font-semibold">@<%= current_account.username %></p>
            <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">Manage your profile and keep your account up to date.</p>
            <%= link_to "View your profile", users_account_path, class: "mt-4 inline-flex text-sm font-semibold text-rose-700 underline-offset-4 hover:underline dark:text-rose-300" %>
          </section>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <p class="font-display font-bold">Find your people</p>
            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">Explore posts and accounts to find more moments worth following.</p>
            <%= link_to "Explore insta", users_explore_path, class: "mt-4 inline-flex text-sm font-semibold text-rose-700 underline-offset-4 hover:underline dark:text-rose-300" %>
          </section>
        </div>
      </aside>
    </div>
  </div>
<% end %>
