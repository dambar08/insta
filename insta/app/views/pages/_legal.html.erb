<section class="mx-auto max-w-6xl px-5 pb-20 pt-10 sm:pb-28 sm:pt-16">
  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-br from-rose-50 via-white to-orange-50 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-slate-900">
    <div class="px-6 py-10 sm:px-12 sm:py-14">
      <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600 dark:text-slate-300">
        <%= link_to "Home", root_path, class: "underline-offset-4 hover:underline" %>
        <span aria-hidden="true">/</span>
        <span>About insta</span>
      </div>
      <p class="mt-8 text-sm font-semibold uppercase tracking-[0.18em] text-rose-700 dark:text-rose-300">The details, made clear</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-6xl"><%= title %></h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-300"><%= summary %></p>
      <p class="mt-7 text-sm text-slate-600 dark:text-slate-400">Last updated <time datetime="<%= local_assigns.fetch(:updated, Date.current.iso8601) %>"><%= local_assigns.fetch(:updated_label, Date.current.strftime("%B %-d, %Y")) %></time></p>
    </div>
  </div>

  <div class="mx-auto mt-10 grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
    <article class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-display prose-headings:tracking-tight prose-a:font-medium prose-a:text-rose-700 hover:prose-a:text-rose-900 dark:prose-a:text-rose-300 dark:hover:prose-a:text-rose-200">
      <%= yield %>
    </article>

    <aside class="h-fit rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="font-display text-lg font-bold tracking-tight">Explore</h2>
      <nav aria-label="Public information" class="mt-4">
        <ul class="space-y-3 text-sm font-medium">
          <% [
            ["About", about_pages_path],
            ["Privacy", privacy_pages_path],
            ["Cookies", cookies_pages_path],
            ["Terms of service", tos_pages_path],
            ["Accessibility", accessibility_pages_path]
          ].each do |label, path| %>
            <li><%= link_to label, path, class: "underline-offset-4 hover:underline aria-[current=page]:underline", aria: { current: ("page" if current_page?(path)) } %></li>
          <% end %>
        </ul>
      </nav>
      <p class="mt-6 border-t border-slate-200 pt-5 text-sm leading-6 text-slate-600 dark:border-slate-700 dark:text-slate-300">New to insta? <%= link_to "Create an account", new_user_registration_path, class: "font-semibold underline underline-offset-4" %>.</p>
    </aside>
  </div>
</section>
